# Copy to .env on the server and fill in. Never commit .env.

# Server's public IPv4, used for WebRTC
PUBLIC_IP=203.0.113.10

# Domain(s) Caddy serves and gets HTTPS certificates for, comma separated
TUNA_DOMAIN=tuna.example.com, www.tuna.example.com

TUNA_USER_PASSWORD=change-me
TUNA_ADMIN_PASSWORD=change-me
