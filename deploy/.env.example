# Copy to .env on the server and fill in. Never commit .env.

# Server's public IPv4, used for WebRTC
PUBLIC_IP=203.0.113.10

# Domains Caddy serves (and gets HTTPS certificates for)
NEKO_DOMAIN=neko.example.com
TUNA_DOMAIN=tuna.example.com

# Original neko instance
NEKO_USER_PASSWORD=change-me
NEKO_ADMIN_PASSWORD=change-me

# Tuna instance
TUNA_USER_PASSWORD=change-me
TUNA_ADMIN_PASSWORD=change-me
