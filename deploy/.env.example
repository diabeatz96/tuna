# Copy to .env on the server and fill in. Never commit .env.

# Server's public IPv4, used for WebRTC
PUBLIC_IP=203.0.113.10

# Domain(s) Caddy serves and gets HTTPS certificates for, comma separated
TUNA_DOMAIN=tuna.example.com, www.tuna.example.com

TUNA_USER_PASSWORD=change-me
TUNA_ADMIN_PASSWORD=change-me

# Optional: post to Discord when the room goes live (notify service).
# The token is an admin key for the server's API: make it long and random,
# e.g. openssl rand -hex 32. The webhook comes from a Discord channel's
# Settings > Integrations > Webhooks.
TUNA_API_TOKEN=
DISCORD_WEBHOOK_URL=
# The address linked in the message
TUNA_URL=https://tuna.example.com
